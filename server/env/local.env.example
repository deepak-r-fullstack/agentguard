# Copy this file to env/local.env (same folder) and adjust values.
# env/local.env is git-ignored, so your keys never reach GitHub.

PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/agentguard
CLIENT_ORIGIN=http://localhost:5173

# Use a long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Demo mode adds the "Reset demo data" button and the agent playground.
# Set to false for a real deployment.
DEMO_MODE=true
# Hosted demo only: create the demo data on first start if the database is empty.
SEED_ON_START=false

# AI is optional. It is only used to draft rules from plain English and to
# turn chat instructions into planned agent actions. The guard never asks AI
# whether an action is allowed.
# LLM_PROVIDER: none | openai | anthropic | ollama
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Only for ollama (local: http://127.0.0.1:11434) or an OpenAI-compatible gateway.
LLM_BASE_URL=

# Slack approvals are optional (see docs/slack-setup.md). Leave both empty to keep them off.
# SLACK_BOT_TOKEN starts with xoxb-, SLACK_SIGNING_SECRET is on the Slack app's "Basic Information" page.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# AgentReplay recording is optional (see README, "Works with AgentReplay"). Leave the key empty to keep it off.
# When set, each playground run is recorded there, and every step links back to its action here.
# AGENTREPLAY_API_KEY is the SDK key (starts with ar_) from AgentReplay's "Apps and keys" screen.
# AGENTREPLAY_URL is only for a self-hosted AgentReplay; leave it empty for the hosted site.
AGENTREPLAY_API_KEY=
AGENTREPLAY_URL=
